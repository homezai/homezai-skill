# Homezai agent API skill configuration.
# Copy this file to `.env` and fill in your token. NEVER commit the real `.env`.

# Base URL of the Homezai API (production).
HOMEZAI_API_BASE_URL=https://api.dev.homezyai.com

# Your user-scoped Homezai API token. Generate or rotate it in the Homezai
# agent portal: Profile settings -> "Agent API Token". It is shown only once —
# paste it here immediately. It grants exactly your own account's access.
HOMEZAI_API_TOKEN=hzai_your_token_here
